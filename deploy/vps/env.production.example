# Copy to .env in this directory (deploy/vps/) and fill every value marked REQUIRED.
# docker compose reads .env for api, worker, dashboard, and caddy.

# --- Postgres (REQUIRED) ---
POSTGRES_USER=spine
POSTGRES_PASSWORD=REQUIRED_long_random_password
POSTGRES_DB=spine

# SQLAlchemy / FastAPI (REQUIRED) — must match db service credentials.
# URL-encode special characters in the password (e.g. @ → %40).
DATABASE_URL=postgresql+asyncpg://spine:REQUIRED_long_random_password@db:5432/spine

# --- API (REQUIRED) ---
ADMIN_API_KEY=REQUIRED_long_random_api_key

# Dashboard JWT signing (REQUIRED in production — must differ from ADMIN_API_KEY).
JWT_SECRET=REQUIRED_long_random_jwt_secret

APP_NAME=Spine
LOG_LEVEL=INFO
ENVIRONMENT=production

# --- Dashboard BFF (REQUIRED) ---
# SPINE_ADMIN_API_KEY is injected from ADMIN_API_KEY by docker compose (do not duplicate).
SESSION_SECRET=REQUIRED_long_random_string

# Comma-separated emails allowed to use Organizations in the dashboard.
BFF_PLATFORM_ADMIN_EMAILS=you@example.com

# Session cookies: omit COOKIE_SECURE (recommended) — Secure follows HTTPS via Caddy.
# COOKIE_SECURE=false

# --- Redis (SSE + monitors) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# --- Live activity stream (SSE) ---
SSE_ENABLED=true
SSE_HEARTBEAT_SECONDS=25

# --- Monitor agents (optional; set MONITOR_ENABLED=true and ANTHROPIC_API_KEY) ---
MONITOR_ENABLED=false
ANTHROPIC_API_KEY=
MONITOR_MODEL=claude-sonnet-5-5
MONITOR_HISTORY_N=20
MONITOR_ESCALATE_CONFIDENCE=0.85
MONITOR_SKIP_IF_POLICY_BLOCKED=true
MONITOR_TYPES=behavioral,exfiltration,compliance,pii,irreversible,intent,privilege,rate_abuse
MONITOR_RATE_ABUSE_ACTION_THRESHOLD=15

# --- Caddy (REQUIRED for public URL) ---
# Real DNS name → automatic HTTPS. HTTP-only by IP: SITE_ADDRESS=:80
SITE_ADDRESS=demo.yourcompany.com

# Public API hostname for agents / OpenClaw (DNS A record → same VPS as SITE_ADDRESS).
# Example: api.demo.spinelayer.com (not the dashboard host).
API_ADDRESS=api.demo.yourcompany.com

# --- Security (optional overrides) ---
# LOGIN_RATE_LIMIT_PER_MINUTE=20
# METADATA_MAX_BYTES=8192
# REASONING_API_MAX_CHARS=500
# METRICS_REQUIRE_ADMIN_KEY=true
# BLOCK_WEBHOOK_PRIVATE_URLS=true
# EGRESS_PROXY_TOKEN=
