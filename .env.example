DATABASE_URL=postgresql+asyncpg://spine:spine@db:5432/spine
ADMIN_API_KEY=change-me

APP_NAME=Spine
LOG_LEVEL=INFO
ENVIRONMENT=local

# JWT secret for user auth. Falls back to ADMIN_API_KEY if unset.
# JWT_SECRET=change-me-long-random-string

# Dashboard BFF session secret
SESSION_SECRET=change-me-long-random-string

# Comma-separated emails allowed to use Organizations UI (BFF proxies with ADMIN_API_KEY)
# BFF_PLATFORM_ADMIN_EMAILS=you@example.com

# Optional: OpenTelemetry OTLP/HTTP (set OTEL_ENABLED=true to turn on)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=spine-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Optional: OIDC admin JWT (in addition to ADMIN_API_KEY)
# OIDC_JWKS_URL=
# OIDC_AUDIENCE=
# OIDC_ISSUER=
# OIDC_JWT_ALGORITHMS=RS256
# OIDC_ADMIN_ROLE=spine_admin

# Optional: docker-compose egress service (set after minting an org key)
# SPINE_ORG_KEY=spine_...
# SPINE_DEFAULT_AGENT_ID=00000000-0000-0000-0000-000000000000
# SPINE_EGRESS_FAIL_OPEN=false

# Optional: seed a demo org/agent/policy via `python tools/seed_demo.py`
# SPINE_SEED_DEMO=true
# SPINE_BASE_URL=http://127.0.0.1:8000

# Monitor agents (async behavioral analysis via Claude + Celery)
# MONITOR_ENABLED=false
# MONITOR_TYPES=behavioral,exfiltration,compliance,pii,irreversible,intent,privilege,rate_abuse
# MONITOR_RATE_ABUSE_ACTION_THRESHOLD=15
# ANTHROPIC_API_KEY=
# MONITOR_MODEL=claude-sonnet-5-5
# MONITOR_HISTORY_N=20
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# MONITOR_ESCALATE_CONFIDENCE=0.85
# MONITOR_SKIP_IF_POLICY_BLOCKED=true

# Live dashboard SSE (Redis pub/sub; requires REDIS_URL / redis service)
# SSE_ENABLED=true
# SSE_HEARTBEAT_SECONDS=25

# Security (production: set ENVIRONMENT=production and strong secrets)
# ENVIRONMENT=local
# JWT_SECRET=change-me-long-random-string
# LOGIN_RATE_LIMIT_PER_MINUTE=20
# METADATA_MAX_BYTES=8192
# REASONING_API_MAX_CHARS=500
# METRICS_REQUIRE_ADMIN_KEY=true
# BLOCK_WEBHOOK_PRIVATE_URLS=true
# EGRESS_PROXY_TOKEN=

# Plan-bound monitoring (context-isolated reviewer; runs when intercept carries a session_id)
# PLAN_DRIFT_FLAG_THRESHOLD=0.4      # create approval ticket at/above this drift score
# PLAN_DRIFT_BLOCK_THRESHOLD=0.6     # auto-block future intercepts in this session at/above
# PLAN_EVAL_HISTORY_WINDOW=10        # how many recent plan_evaluations the reviewer sees
